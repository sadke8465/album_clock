{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "albumclock",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.csv"
			],
			"fallthrough": true
		}
	],
	"vars": {
		"LAST_FM_USER": "Noamsadi95",
		"ROTATION_SECONDS": "600",
		"USER_AGENT": "album-matrix-clock/2.0 (+https://github.com/sadke8465/album_clock)"
	},
	"secrets": {
		"required": [
			"LAST_FM_API_KEY"
		]
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "925e430471d2464cb6fc3ff3787a4426"
		}
	],
	"r2_buckets": [
		{
			"binding": "FRAMES",
			"bucket_name": "albumclock-frames"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "NOW_PLAYING",
				"class_name": "NowPlayingCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"NowPlayingCoordinator"
			]
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	}
}
